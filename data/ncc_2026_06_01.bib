@article{ WOS:000704888400001,
Author = {Czekajlo, Agatha and Coops, Nicholas C. and Goodbody, Tristan R. H.},
Title = {Untangling the effect of urban vegetation type and structure on
   spectrally unmixed greenness},
Journal = {REMOTE SENSING LETTERS},
Year = {2021},
Volume = {12},
Number = {12},
Pages = {1216-1226},
Month = {DEC 2},
Abstract = {Measurements of vegetation greenness, such as those derived from
   spectral unmixing of satellite imagery using a
   greenness-darkness-brightness model, are crucial for improved mapping
   and analysis of urban greenspaces and their socio-ecological benefits.
   Differences in vegetation types and structures can, however, influence
   how spectral wavelengths are reflected and thus represented through
   unmixed greenness and darkness fractions. This study untangles the
   relationship and distribution of sub-pixel greenness and darkness across
   key structural metrics for coniferous, deciduous, and low vegetation in
   select Vancouver, Canada greenspaces. We utilized airborne laser
   scanning (ALS) data to describe structural components of canopy cover,
   canopy height, rumple index, and vertical variability, which were then
   analysed with spectrally unmixed greenness and darkness fractions from
   Landsat satellite imagery and available land cover data. Greenness was
   linked to vegetation type, whereas darkness was also influenced by
   structure, especially for conifers. Specifically, tall conifers observed
   twice as much darkness as greenness, and darkness increased by similar
   to 30\% to match moderate greenness levels of high-coverage deciduous
   stands. Results correspond to previous work on biophysical differences
   and shadowing effects from tree crowns. Future greenspace research
   utilizing spectrally unmixed greenness fractions should be mindful of
   potential shadowing impacts caused by tall and/or dense vegetation.},
Publisher = {TAYLOR \& FRANCIS LTD},
