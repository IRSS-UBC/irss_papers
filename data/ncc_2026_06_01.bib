Address = {VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Bolton, DK (Corresponding Author), Univ British Columbia, Fac Forestry, Dept Forest Resources Management, 2424 Main Mall, Vancouver, BC V6T 1Z4, Canada.
   Bolton, Douglas K.; Coops, Nicholas C., Univ British Columbia, Fac Forestry, Dept Forest Resources Management, Vancouver, BC V6T 1Z4, Canada.
   Wulder, Michael A., Nat Resources Canada, Pacific Forestry Ctr, Canadian Forest Serv, Victoria, BC V8Z 1M5, Canada.},
DOI = {10.1007/s10661-012-3051-9},
ISSN = {0167-6369},
EISSN = {1573-2959},
Keywords = {Forest structure; Productivity; Lidar; Remote sensing; Boreal},
