@article{ WOS:001505301300001,
Author = {Gerbrecht, Evan C. and Coops, Nicholas C. and Carroll, Allan L. and
   Bater, Christopher W. and Buechner, Leonard},
Title = {Estimation of Forest Structure and Fuel Change Across Mountain Pine
   Beetle - Attacked Forests Using Mobile and RPAS - Based LiDAR},
Journal = {CANADIAN JOURNAL OF REMOTE SENSING},
Year = {2025},
Volume = {51},
Number = {1},
Month = {DEC 31},
Abstract = {The recent mountain pine beetle (Dendroctonus ponderosae) outbreak has
   resulted in widespread mortality of pine trees across western Canada
   over the past two decades. The changes to forest structure caused by the
   beetle are well known through ground-based observations. However, the
   potential changes to fuels for wildfires associated with altered forest
   structure are not well known nor incorporated into fire fuel models. In
   this study, we used light detection and ranging (LiDAR) to quantify
   variations in forest structure and wildfire fuels caused by mountain
   pine beetle (MPB) infestation. From this data, we created models that
   characterize fuels following MPB attack. LiDAR metrics were extracted
   from three-dimensional point clouds acquired using remotely piloted
   aircraft systems (RPAS) and mobile laser scanning (MLS), both
   individually and combined. Fuel components in the stand were then
   modeled across a range of MPB attack severities. Results indicated the
   fused model was most accurate at predicting canopy fuel load (R2 =
   0.80), while MLS had the best model performance for shrub fuel load (R2
   = 0.68) and coarse woody debris fuel load (R2 = 0.68). This study
   demonstrates the ability of LiDAR to accurately characterize forest fuel
   loads in MPB-infested forests.
   La r \& eacute;cente \& eacute;closion de dendroctone du pin ponderosae
   (Dendroctonus ponderosae) a entra \& icirc;n \& eacute; une mortalit \&
   eacute; des pins dans l'ouest du Canada au cours des deux derni \&
   egrave;res d \& eacute;cennies. Les changements de la structure des for
   \& ecirc;ts caus \& eacute;s par le scolyte sont bien connus gr \&
   acirc;ce aux observations au sol. Cependant, les changements potentiels
   des combustibles des feux foresti \& egrave;res associ \& eacute;s \&
   agrave; la modification de la structure des for \& ecirc;ts ne sont pas
   bien connus et ne sont pas int \& eacute;gr \& eacute;s dans les mod \&
   egrave;les de combustible pour incendies. Dans cette \& eacute;tude,
   nous avons utilis \& eacute; la d \& eacute;tection de lumi \& egrave;re
   et le t \& eacute;l \& eacute;m \& eacute;trie (<< LiDAR >>) pour
   quantifier les variations de la structure des for \& ecirc;ts et des
   combustibles utilis \& eacute;s lors des feux de for \& ecirc;t caus \&
   eacute;s par l'infestation du dendroctone du pin ponderosa (<< MPB >>).
   \& Agrave; partir de ces donn \& eacute;es, nous avons cr \& eacute;\&
   eacute; des mod \& egrave;les qui caract \& eacute;risent les
   combustiles apr \& egrave;s une attaque par le MPB. Les mesures LiDAR
   ont \& eacute;t \& eacute; extraites de nuages de points
   tridimensionnels acquis \& agrave; l'aide de syst \& egrave;mes d'a \&
   eacute;ronefs t \& eacute;l \& eacute;pilot \& eacute;s (<< RPAS >>) et
   de balayage laser mobile (<< MLS >>), individuellement et en
   combinaison. Les composants des combustibles dans le peuplement ont
   ensuite \& eacute;t \& eacute; mod \& eacute;lis \& eacute;s pour une
   gamme de s \& eacute;v \& eacute;rit \& eacute; des attaques MPB. Les r
   \& eacute;sultats ont indiqu \& eacute; que le mod \& egrave;le fusionn
   \& eacute; \& eacute;tait le plus pr \& eacute;cis pour pr \&
   eacute;dire la charge de combustible dans le couvert (R2 = 0,80), tandis
   que le mod \& egrave;le MLS avait le meilleur rendement pour la charge
   de combustible dans les arbustes (R2 = 0,68) et la charge de combustible
   dans les d \& eacute;bris ligneux grossiers (R2 = 0,68). Cette \&
   eacute;tude d \& eacute;montre la capacit \& eacute; du LiDAR \& agrave;
   caract \& eacute;riser avec pr \& eacute;cision les charges de
   combustible forestier dans les for \& ecirc;ts infest \& eacute;es par
   le MPB.},
