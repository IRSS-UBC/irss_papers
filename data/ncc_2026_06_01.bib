@article{ WOS:000281858400001,
Author = {Hilker, Thomas and Nesic, Zoran and Coops, Nicholas C. and Lessard,
   Dominic},
Title = {A NEW, AUTOMATED, MULTIANGULAR RADIOMETER INSTRUMENT FOR TOWER-BASED
   OBSERVATIONS OF CANOPY REFLECTANCE (AMSPEC II)},
Journal = {INSTRUMENTATION SCIENCE \& TECHNOLOGY},
Year = {2010},
Volume = {38},
Number = {5},
Pages = {319-340},
Abstract = {Plant photosynthesis is critical for understanding carbon cycling at
   landscape and global scales. While tower-based measurements of CO2 have
   enhanced our knowledge of ecosystem fluxes, scaling these measurements
   globally is difficult. Satellite observations provide full, global
   coverage and hold the potential of spatially continuous measurements of
   ecosystem fluxes, but the requirements for modeling these fluxes from
   satellite-derived surface parameters are not well understood. This
   article describes the further development of a tower-mounted, automated,
   multiangular spectroradiometer system (AMSPEC II) used to study the
   relationships between canopy-reflectance and plant-physiological
   processes from multiangular observations, thereby facilitating a
   comprehensive modeling of the bidirectional reflectance distribution of
   the canopy. A Webcam permits simultaneous monitoring of phenological
   changes over time.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
