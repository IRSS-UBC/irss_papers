@article{ WOS:001310508600001,
Author = {Berman, Ethan E. and Coops, Nicholas C. and Robere-McGugan, Geordie and
   Sinclair, Ian and McCartney, Grant and Achim, Alexis},
Title = {Updating Forest Stand Inventories: Integration of Photo-Interpreted and
   Airborne Laser Scanning Forest Attributes Using Generic Region Merging
   Segmentation and kNN Imputation},
Journal = {CANADIAN JOURNAL OF REMOTE SENSING},
Year = {2024},
Volume = {50},
Number = {1},
Month = {DEC 31},
Abstract = {Integrating airborne laser scanning (ALS) forest attributes with
   photo-interpreted forest stand age and species attributes can provide
   managers with the best information to drive estate planning, growth and
   yield projections, and forest operations. Photo-interpreted forest
   inventories provide certain forest attributes that are difficult to
   measure with ALS, yet are subjective and irregularly updated. ALS is
   objective and provides detailed estimates of forest structure
   attributes, but poorly estimates age and species composition. We used
   Generic Region Merging segmentation and k-nearest neighbor imputation to
   integrate photo-interpreted and ALS-derived forest attributes into a
   contemporary stand-based forest inventory. We first segmented gridded
   ALS attributes into forest stand polygons across a similar to 630,000 ha
   managed forest in Ontario, Canada. We next applied imputation to a
   photo-interpreted inventory, assessing the influence of model parameters
   and imputed vs. observed values of age and species using leave-one-out
   cross-validation. Compared to the photo-interpreted inventory, the
   optimal imputation model estimated age with a mean absolute and mean
   bias difference of 16.06 and -0.14 years, and classified leading species
   with 65.46\% accuracy. We lastly integrated imputed age and species
   attributes into the automatically segmented forest stand polygons,
   finding similar age and species distributions across the landscape when
   compared to the photo-interpreted inventory.
   L'int \& eacute;gration des attributs de la for \& ecirc;t par balayage
   laser a \& eacute;roport \& eacute;e (<< airborne laser scanning (ALS)
   >>) avec les attributs photo-interpr \& eacute;t \& eacute;s de l'\&
   acirc;ge et des esp \& egrave;ces des peuplements forestiers peuvent
   fournir aux gestionnaires les meilleures informations pour orienter la
   planification des domaines, les projections de croissance et de
   rendement et les op \& eacute;rations foresti \& egrave;res. Les
   inventaires forestiers par photo-interpr \& eacute;tation fournissent
   certains attributs forestiers qui sont difficiles \& agrave; mesurer
   avec l'ALS, mais qui sont subjectifs et misent \& agrave; jour d'une fa
   \& ccedil;on irr \& eacute;guli \& egrave;re. L'ALS est objective et
   fournit des estimations d \& eacute;taill \& eacute;es des attributs de
   la structure foresti \& egrave;re, mais elle estime mal l'\& acirc;ge et
   la composition des esp \& egrave;ces. Nous avons utilis \& eacute; la
   segmentation de fusion des r \& eacute;gions g \& eacute;n \&
   eacute;riques (<< Generic Region Merging segmentation >>) et
   l'imputation du voisin le plus proche pour int \& eacute;grer les
   attributs forestiers photo-interpr \& eacute;t \& eacute;s et d \&
   eacute;riv \& eacute;s de l'ALS dans un inventaire forestier
   contemporain bas \& eacute; sur des peuplements. Nous avons d'abord
   segment \& eacute; les attributs de l'ALS en polygones forestiers sur
   environ 630 000 ha de for \& ecirc;t g \& eacute;r \& eacute;e en
   Ontario, au Canada. Nous avons ensuite appliqu \& eacute; l'imputation
   \& agrave; un inventaire photo-interpr \& eacute;t \& eacute;, en \&
   eacute;valuant l'influence des param \& egrave;tres du mod \& egrave;le
   de l'\& acirc;ge et d'esp \& egrave;ce et imput \& eacute;es vs. observ
   \& eacute;es en utilisant la m \& eacute;thode de validation <<
   leave-one-out cross-validation >>. Compar \& eacute; \& agrave;
   l'inventaire photo-interpr \& eacute;t \& eacute;, le mod \& egrave;le
   d'imputation optimale a estim \& eacute; l'\& acirc;ge avec une moyenne
   absolue et moyenne de diff \& eacute;rence de biais de 16,06 et -0,14
   ans et a class \& eacute; les esp \& egrave;ces principales avec une pr
   \& eacute;cision de 65,46 \%. Nous avons enfin int \& eacute;gr \&
   eacute; des attributs d'\& acirc;ge et d'esp \& egrave;ces imput \&
   eacute;s dans les polygones des peuplements forestiers segment \&
   eacute;s automatiquement, en trouvant des distributions d'\& acirc;ge et
   d'esp \& egrave;ce similaires dans le paysage par rapport \& agrave;
   l'inventaire photo-interpr \& eacute;t \& eacute;.},
