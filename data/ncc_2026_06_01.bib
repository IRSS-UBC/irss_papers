   Hember, Robbie A.; Coops, Nicholas C., Univ British Columbia, Fac Forestry, Vancouver, BC, Canada.
   Hember, Robbie A.; Kurz, Werner A., Canadian Forest Serv, Pacific Forestry Ctr, Nat Resources, Victoria, BC, Canada.},
DOI = {10.1016/j.foreco.2017.09.072},
