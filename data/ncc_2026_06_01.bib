Title = {A SPACE-TIME DATA CUBE: MULTI-TEMPORAL FOREST STRUCTURE MAPS FROM
   LANDSAT AND LIDAR},
Booktitle = {2017 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING SYMPOSIUM (IGARSS)},
