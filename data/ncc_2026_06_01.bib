@article{ WOS:001707306600001,
Author = {Brown, Madison S. and Coops, Nicholas C. and Mulverhill, Christopher and
   Achim, Alexis},
Title = {Characterizing the Impact of Non-Stand Replacing Disturbances on LiDAR
   Based Forest Structure Using a Harmonized Landsat-Sentinel-2 Time-Series},
Journal = {CANADIAN JOURNAL OF REMOTE SENSING},
Year = {2026},
Volume = {52},
Number = {1},
Month = {DEC 31},
Abstract = {Non-stand replacing disturbances (NSRs) are events that do not result in
   complete removal of forest stands (e.g., insect infestation, windthrow).
   Forest structural change associated with NSRs can impact forest
   productivity and health, necessitating the need for both detection of
   NSR's and characterization of their impact. The increased accessibility
   of frequent-revisit, medium-resolution satellite imagery, has led to an
   increase in algorithms designed to detect sub-annual change. The
   Bayesian Estimator of Abrupt change, Seasonal change, and Trend (BEAST)
   has shown promise in both detecting NSRs on a sub-annual basis and
   estimating forest structure changes. This study assesses the impact of
   NSRs on structure across a dry forest in Western Canada with a case
   study on aspen leafminer (Phyllocnistis populiella) and two-year budworm
   (Choristoneura biennis). Three LiDAR derived forest attributes were
   modeled (i.e., canopy cover, height and height variability) using BEAST
   derived predictors variables as inputs (R2 between 0.5-0.7) and then
   applied across the study area. Results showed changes in structure over
   the period of continuous NSRs, including an 11\% decline in canopy
   cover. This approach enables the structural change caused by NSRs to be
   more rapidly identified, providing practitioners with approaches to
   better identify areas in need of intervention.
   Les perturbations entra \& icirc;nant des modifications partielles
   (PEMP) de la structure foresti \& egrave;re sont des \& eacute;v \&
   eacute;nements qui ne provoquent pas la disparition compl \& egrave;te
   des peuplements forestiers (p. ex., infestation d'insectes, chablis).
   Les changements structuraux associ \& eacute;s aux PEMP peuvent affecter
   la productivit \& eacute; et la sant \& eacute; des for \& ecirc;ts, d'o
   \& ugrave; la n \& eacute;cessit \& eacute; de d \& eacute;tecter ces
   perturbations et de caract \& eacute;riser leurs impacts. L'accessibilit
   \& eacute; accrue d'images satellitaires \& agrave; r \& eacute;solution
   moyenne et \& agrave; fr \& eacute;quence de revisite \& eacute;lev \&
   eacute;e a permis le d \& eacute;veloppement d'algorithmes con \&
   ccedil;us pour d \& eacute;tecter les changements infra-annuels.
   L'estimateur bay \& eacute;sien des changements abrupts, des changements
   saisonniers et des tendances (BEAST) s'est r \& eacute;v \& eacute;l \&
   eacute; prometteur pour la d \& eacute;tection des PEMP \& agrave; l'\&
   eacute;chelle infra-annuelle et l'estimation des changements structuraux
   forestiers. Cette \& eacute;tude \& eacute;value l'impact des PEMP sur
   la structure d'une for \& ecirc;t de l'Ouest canadien par une \&
   eacute;tude de cas portant sur la mineuse du peuplier faux-tremble
   (Phyllocnistis populiella) et la tordeuse bisannuelle de l'\&
   eacute;pinette (Choristoneura biennis). Trois attributs forestiers d \&
   eacute;riv \& eacute;s de donn \& eacute;es LiDAR (le taux de couvert
   forestier, la hauteur et sa variabilit \& eacute;) ont \& eacute;t \&
   eacute; mod \& eacute;lis \& eacute;s \& agrave; l'aide de variables pr
   \& eacute;dictives issues du logiciel BEAST (R \& sup2; compris entre
   0,5 et 0,7), puis appliqu \& eacute;s \& agrave; l'ensemble de la zone
   d'\& eacute;tude. Les r \& eacute;sultats ont permis d'identifier une r
   \& eacute;duction continue par des PEMP pour la p \& eacute;riode de
   l'\& eacute;tude, notamment une diminution de 11 \% du couvert
   forestier. L'approche \& agrave; l'aide de s \& eacute;ries temporelles
   harmonis \& eacute;es Landsat-Sentinel-2 permet d'identifier
   efficacement les modifications structurelles induites par les PEMP,
   offrant ainsi aux praticiens des outils pour mieux cibler les zones n \&
   eacute;cessitant une intervention.},
