Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Douglas, TJ (Corresponding Author), Univ British Columbia, Fac Forestry, 2424 Main Mall, Vancouver, BC V6T 1Z4, Canada.
